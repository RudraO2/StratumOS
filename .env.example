# Stratum Web - environment
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# On Vercel, set the same names under Project -> Settings -> Environment Variables.

# --- Model plane (Groq, primary) ---------------------------------------------
# Two open-weight models hosted on Groq stand in for the product's two local ones.
# Read only by api/turn.ts - never bundled into the browser.
GROQ_API_KEY=
# Text lane: tool routing in chat, prose for single-figure and "why" answers.
STRATUM_MODEL_TEXT=openai/gpt-oss-20b
# Vision lane: a scanned page attached to a message is read here.
STRATUM_MODEL_VISION=qwen/qwen3.8-27b

# --- Fallback model plane (Gemini API, Gemma 4) ------------------------------
# Used only when Groq fails before producing anything. Leave empty to disable.
GEMINI_API_KEY=
STRATUM_FALLBACK_TEXT=gemma-4-26b-a4b-it
STRATUM_FALLBACK_VISION=gemma-4-31b-it
